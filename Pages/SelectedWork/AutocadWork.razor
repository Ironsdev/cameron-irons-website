@page "/SelectedWork/autocad"
@inherits LayoutComponentBase

@using MudBlazor.Utilities

<DefaultAppBar />

<div class="app-layout-container">

    @* We use a single wrapper div for the content so the padding class works correctly *@
    <div class="right-content-padding">

        @* Left Panel: This panel uses position: fixed. It is OUTSIDE the grid flow slightly now for clarity *@
        <div class="fixed-desktop-left">
            <MudPaper Class="pa-4 d-flex flex-column justify-center align-center" Elevation="0" Height="100vh">
                <MudText Color="Color.Dark" Typo="Typo.h5" Style="font-family: TitleFont2">
                    AutoCAD Deck Draft
                </MudText>
                <MudText Color="Color.Primary" Typo="Typo.h4" Style="font-family: TitleFont2" Class="mt-2">
                    Greg Sievers & Co
                </MudText>
                <MudText Typo="Typo.h6" Style="font-family: Garamond" Align="Align.Center">
                    For this project, I was commissioned to develop a draft construction drawing in AutoCAD for Greg
                    Sievers & Co. for a deck reconstruction within the historic district of St. Louis. All three
                    drawings passed the Architectural Review Board (ARB) on the first submission, demonstrating
                    compliance with historic district guidelines, as well as proper scale, proportion, and contextual
                    integration with the proposed deck design.
                </MudText>
            </MudPaper>
        </div>

        @* Right Panel: The content that flows naturally *@
        <MudPaper Class="pa-4" Square="true" Elevation="0">
            <MudImage Src="images/autocad/autocad_deck1.png" Alt="Model Lineup"
                Style="max-width: 100%; height: auto;" />
            <MudImage Src="images/autocad/autocad_deck2.png" Alt="Model Lineup"
                Style="max-width: 100%; height: auto;" />
            <MudImage Src="images/autocad/autocad_deck3.png" Alt="Model Lineup"
                Style="max-width: 100%; height: auto;" />
        </MudPaper>
    </div>
</div>